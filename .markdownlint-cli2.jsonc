// markdownlint の設定（ルール一覧：https://github.com/DavidAnson/markdownlint）
{
  "config": {
    "default": true,
    // 日本語は1行が長くなりやすいので、行の長さは制限しない
    "MD013": false,
    // 記事の中で HTML を使うことを許可する
    "MD033": false,
    // タイトルは Front Matter に書くので、本文の最初が見出しでなくてもよい
    "MD041": false,
    // 日本語のブログでは見出しを「！」「？」で終えることがあるので許可する
    "MD026": false,
    // 「$ コマンド」のようにプロンプト付きで書く書き方を許可する
    "MD014": false,
    // {% linkcard "https://..." %} の URL まで「リンクになっていない URL」と判定されてしまうため
    "MD034": false
  }
}
